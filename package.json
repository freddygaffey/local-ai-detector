{
  "name": "local-ai-detector",
  "description": "Free, open-source, fully local AI-content detector browser extension.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:e2e": "wxt build --mode e2e",
    "build:e2e:firefox": "wxt build -b firefox --mode e2e",
    "e2e:chrome": "node scripts/e2e/chrome.mjs",
    "e2e:firefox": "node scripts/e2e/firefox.mjs",
    "lint:firefox": "web-ext lint -s .output/firefox-mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "node scripts/copy-vendor-assets.mjs && wxt prepare",
    "predev": "node scripts/copy-vendor-assets.mjs",
    "predev:firefox": "node scripts/copy-vendor-assets.mjs",
    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "prebuild:firefox": "node scripts/copy-vendor-assets.mjs",
    "prebuild:e2e": "node scripts/copy-vendor-assets.mjs",
    "prebuild:e2e:firefox": "node scripts/copy-vendor-assets.mjs",
    "prezip": "node scripts/copy-vendor-assets.mjs",
    "prezip:firefox": "node scripts/copy-vendor-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "0.15.2",
    "@huggingface/transformers": "4.3.0",
    "c2pa-text": "^3.0.0",
    "exifreader": "^4.46.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "puppeteer-core": "^25.12.0",
    "selenium-webdriver": "^4.49.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0",
    "wxt": "0.21.4"
  }
}
